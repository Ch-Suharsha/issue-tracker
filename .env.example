# Local SQLite (default). Production: Neon Postgres connection string.
DATABASE_URL=sqlite:///./dev.db

# --- Profile A: public demo (Render) ---
# DATABASE_URL=<neon-pooled-url>
# DEMO_MODE=true
# Do NOT set TYPESAFE_API_KEY on public demo.

# --- Profile B: local / private live Jev ---
# DEMO_MODE=false
# TYPESAFE_API_KEY=<from console.typesafe.ai>
# TYPESAFE_MODEL=jev-latest
# JEV_MIN_CONFIDENCE=0.5

# Public demo: block intake/approve/reject; browse seeded examples only.
DEMO_MODE=false

# Optional — GitHub import rate limits (public Issues only).
# GITHUB_TOKEN=

# TypeSafe Jev — when set (and DEMO_MODE=false), triage uses Jev instead of FakeClassifier.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Optional — force human approval when Jev min confidence is below threshold.
# JEV_MIN_CONFIDENCE=

# Force FakeClassifier even when TYPESAFE_API_KEY is set (debugging).
# CLASSIFIER=fake
